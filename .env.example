# Copia este archivo a ".env" y completa los valores.
# Nunca subas el archivo ".env" real al repositorio.

# --- General ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Base de datos ---
DATABASE_URL=sqlite:///database/newsroom.db

# --- WordPress (usado por el futuro agente WordPress) ---
WORDPRESS_SITE_URL=
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=

# --- Telegram (usado por el futuro agente Telegram) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Proveedores de IA (usados por los futuros agentes Writer / SEO / AI Orchestrator) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
