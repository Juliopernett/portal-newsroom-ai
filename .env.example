# Copia este archivo a ".env" y completa los valores.
# Nunca subas el archivo ".env" real al repositorio.

# --- General ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Base de datos ---
# Local (default): SQLite, cero configuración.
DATABASE_URL=sqlite:///database/newsroom.db
# Railway (Sprint 3C): copia el valor de la variable DATABASE_URL que
# Railway inyecta automáticamente al agregar un plugin de PostgreSQL. Si
# viene como "postgres://...", no hace falta corregirlo a mano —
# database/engine.py lo normaliza a "postgresql+psycopg://" en runtime.
# DATABASE_URL=postgres://usuario:password@host.railway.internal:5432/railway

# --- WordPress (usado por el futuro agente WordPress) ---
WORDPRESS_SITE_URL=
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=

# --- Telegram (usado por el futuro agente Telegram) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Proveedores de IA (usados por los futuros agentes Writer / SEO / AI Orchestrator) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
